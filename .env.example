OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Generate a private .env with node editor/configure.mjs.
POSTGRES_PASSWORD=
EDITOR_SECRET=
EDITOR_SETUP_TOKEN=
DOMAIN=localhost
# Cockpit: prepare privately on the server with tools/cockpit-phase0.py.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://vanventure.at/api/cockpit/youtube/callback
# Exactly 32 random bytes encoded as 64 lowercase hexadecimal characters.
COCKPIT_TOKEN_ENCRYPTION_KEY=
YOUTUBE_CHANNEL_ID=
COCKPIT_SYNC_ENABLED=false
